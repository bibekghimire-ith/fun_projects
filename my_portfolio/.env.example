# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
# Set to "production" only once the app is served over HTTPS (e.g. behind a
# TLS-terminating reverse proxy). It controls whether the admin session
# cookie is marked HTTPS-only — leaving this as "production" while serving
# plain http:// will make the admin login cookie never come back, so login
# will look like it's failing.
ENVIRONMENT=development
SITE_NAME=My Portfolio

# --- Admin bootstrap (only used the very first time the app starts and no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Database ---
# Used as-is when set. Compose derives it from the POSTGRES_* vars below if left unset.
DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@db:5432/portfolio

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
