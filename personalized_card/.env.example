# Application
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://letter:letter@localhost:5432/letter_db

# JWT (use `openssl rand -hex 32` to generate)
JWT_SECRET=your-jwt-secret-minimum-32-characters-long-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your-cookie-secret-minimum-32-characters

# Media Storage
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50

# S3 / MinIO (only needed if MEDIA_STORAGE_PROVIDER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=letter-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# CORS
CORS_ORIGIN=http://localhost:5173

# Templates
# Optional folder of extra template JSON files, registered at startup.
# TEMPLATES_EXTRA_DIR=./templates-extra

# PIN gate
# Failed attempts allowed per experience + visitor before a lockout, and how
# long that lockout lasts. In-memory, per API process.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
# A coarser net in front of PIN_MAX_ATTEMPTS: caps /verify calls per IP across
# ALL experiences, so one IP can't just keep changing which letter it targets.
PIN_VERIFY_RATE_LIMIT_MAX=5
