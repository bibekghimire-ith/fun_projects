# Copy this file to .env for local development and fill in real values.
# Never commit the resulting .env file.

# --- Core ---
# development | testing | production
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
# Public base URL of this deployment (used for absolute links, sitemap, RSS).
BASE_URL=http://localhost:5000
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL connection string, e.g.:
# postgresql+psycopg://portfolio:portfolio@db:5432/portfolio
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# --- Session / cookies ---
# Set to "true" when served over HTTPS (always true in production).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=720

# --- Security headers / reverse proxy (Phase 8) ---
# Sends Strict-Transport-Security. Defaults to true in production, false
# elsewhere. Only meaningful once you're actually served over HTTPS.
ENABLE_HSTS=false
HSTS_MAX_AGE=63072000
# Trust X-Forwarded-Proto/X-Forwarded-For/X-Forwarded-Host from PROXY_COUNT
# reverse-proxy hop(s) in front of the app (e.g. Nginx - see
# deploy/nginx/portfolio.conf and the `proxy` docker-compose profile).
# Only enable when such a proxy is actually the sole entry point - see
# docs/DECISIONS.md.
TRUST_PROXY_HEADERS=false
PROXY_COUNT=1

# --- Admin bootstrap (Phase 1) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Preferred in production: a pre-hashed password (never a plaintext value)
# used to seed the first administrator account on first run. Generate with:
#   flask hash-password
ADMIN_BOOTSTRAP_PASSWORD_HASH=
# Dev-only convenience: a plaintext password, hashed automatically at
# bootstrap time. Never set this in production - use
# ADMIN_BOOTSTRAP_PASSWORD_HASH instead.
ADMIN_BOOTSTRAP_PASSWORD=
# Login rate limit passed to Flask-Limiter (see RATELIMIT_STORAGE_URI below).
LOGIN_RATE_LIMIT=5 per minute;20 per hour

# --- Mail adapter (Phase 7) ---
# console | smtp
MAIL_PROVIDER=console
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER=

# --- Storage adapter (Phase 7) ---
# local | s3 (s3 is not implemented yet; falls back to local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=instance/uploads
# Maximum accepted upload size, in bytes.
MEDIA_MAX_UPLOAD_BYTES=5242880

# --- Contact form (Phase 7) ---
# Address the "New contact message" notification is sent to. Leave blank to
# skip notification entirely (the message is still saved and visible at
# /admin/messages) - see docs/DECISIONS.md.
CONTACT_NOTIFY_EMAIL=

# --- Rate limiting (Phase 1/7) ---
# Use a redis:// URI in production for multi-worker deployments.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour
CONTACT_RATE_LIMIT=5 per hour;20 per day

# --- Docker Compose only ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
